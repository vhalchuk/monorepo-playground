{
    "name": "@my-repo/client",
    "type": "module",
    "scripts": {
        "dev": "concurrently --names \"BROWSER,SSR\" --prefix-colors \"green,yellow\" \"npm run dev:browser\" \"npm run dev:ssr\"",
        "dev:ssr": "webpack -c webpack/ssr-entry.dev.cjs",
        "dev:browser": "webpack serve -c webpack/browser-entry.dev.cjs",
        "clean": "rimraf ./dist",
        "build": "npm run build:ssr && npm run build:browser",
        "build:ssr": "webpack -c webpack/ssr-entry.prod.cjs",
        "build:browser": "webpack -c webpack/browser-entry.prod.cjs",
        "analyze": "npm run build:client -- --env analyze",
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "@my-repo/shared": "*",
        "lodash": "^4.17.21",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "@reduxjs/toolkit": "^2.6.1",
        "react-redux": "^9.2.0"
    },
    "devDependencies": {
        "@types/lodash": "^4.17.16",
        "@types/react": "^18.3.1",
        "@types/react-dom": "^18.3.1",
        "@types/webpack-env": "^1.18.8",
        "@types/react-redux": "^7.1.34",
        "rimraf": "~6.0.0",
        "concurrently": "^9.1.2",
        "babel-loader": "^10.0.0",
        "babel-plugin-lodash": "^3.3.4",
        "@babel/preset-env": "^7.26.9",
        "@babel/preset-react": "^7.26.3",
        "@babel/preset-typescript": "^7.26.0",
        "typescript": "^5.8.2",
        "webpack": "^5.98.0",
        "webpack-dev-server": "^5.2.0",
        "webpack-bundle-analyzer": "^4.10.2",
        "webpack-cli": "^6.0.1",
        "webpack-assets-manifest": "^5.2.1",
        "webpack-merge": "^6.0.1"
    }
}
