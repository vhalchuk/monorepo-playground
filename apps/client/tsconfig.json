{
    "extends": "../../tsconfig.json",

    "compilerOptions": {
        /* If NOT transpiling with TypeScript: */
        "module": "preserve",
        "noEmit": true,

        /* If your code runs in the DOM: */
        "lib": ["es2022", "dom", "dom.iterable"],

        "paths": {
            "@/*": ["./src/*"],
            "@my-repo/shared": ["../../packages/shared/src/index.ts"]
        }
    },
    "include": [
        "src",
    ]
}
